 Insightly;movable=0;" vertex="1" parent="n_A23"><mxGeometry x="30.9" y="-16.0" width="88.2" height="13" as="geometry"/></mxCell><mxCell id="n_A24" value="Close opportunity" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;" vertex="1" parent="lane_R2"><mxGeometry x="5685.0" y="116.0" width="150.0" height="56.0" as="geometry"/></mxCell><mxCell id="n_A24_tag00" value="TL-08 · Insightly" style="rounded=1;arcSize=50;html=1;fontSize=8;fontColor=#374151;strokeColor=#6B7280;fillColor=#FFFFFF;spacing=0;tooltip=TL-08 · Insightly;movable=0;" vertex="1" parent="n_A24"><mxGeometry x="30.9" y="-16.0" width="88.2" height="13" as="geometry"/></mxCell><mxCell id="n_A24_note" value="Record reasoning; revert to contact" style="text;html=1;whiteSpace=wrap;fontSize=8;fontStyle=2;fontColor=#6B7280;align=center;verticalAlign=top;movable=0;" vertex="1" parent="n_A24"><mxGeometry x="-15" y="58" width="180" height="24" as="geometry"/></mxCell><mxCell id="n_E2" value="Opportunity closed" style="ellipse;html=1;whiteSpace=wrap;verticalLabelPosition=bottom;verticalAlign=top;fontSize=9;fontColor=#6B7280;strokeWidth=3.5;aspect=fixed;" vertex="1" parent="lane_R4"><mxGeometry x="5953.0" y="161.0" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="sticky_0" value="No contact history surfaced at outreach time, so owners may over-contact a lead or pitch a service line the lead already declined." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#FFF3A3;strokeColor=#E3C94C;" vertex="1" parent="1"><mxGeometry x="2101.0" y="518.0" width="150.0" height="66.0" as="geometry"/></mxCell><mxCell id="sticky_0_link" style="endArrow=none;dashed=1;dashPattern=2 2;strokeColor=#E3C94C;html=1;" edge="1" parent="1" source="sticky_0" target="n_A7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sticky_1" value="No defined criteria for when to cease outreach; it is currently a judgment call. Flagged as an open action item." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#FFF3A3;strokeColor=#E3C94C;" vertex="1" parent="1"><mxGeometry x="1893.0" y="518.0" width="150.0" height="66.0" as="geometry"/></mxCell><mxCell id="sticky_1_link" style="endArrow=none;dashed=1;dashPattern=2 2;strokeColor=#E3C94C;html=1;" edge="1" parent="1" source="sticky_1" target="n_D3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sticky_2" value="Contacts that were once leads should still receive periodic nurture (white papers, campaigns) on a priority cadence, but there is no mechanism for this today." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#FFF3A3;strokeColor=#E3C94C;" vertex="1" parent="1"><mxGeometry x="2101.0" y="838.0" width="150.0" height="66.0" as="geometry"/></mxCell><mxCell id="sticky_2_link" style="endArrow=none;dashed=1;dashPattern=2 2;strokeColor=#E3C94C;html=1;" edge="1" parent="1" source="sticky_2" target="n_A8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sticky_3" value="Lead reassignment decisions tend to escalate to the ELT, pulling leadership into minutia; no sales director role exists to absorb this." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#FFF3A3;strokeColor=#E3C94C;" vertex="1" parent="1"><mxGeometry x="1477.0" y="310.0" width="150.0" height="66.0" as="geometry"/></mxCell><mxCell id="sticky_3_link" style="endArrow=none;dashed=1;dashPattern=2 2;strokeColor=#E3C94C;html=1;" edge="1" parent="1" source="sticky_3" target="n_A5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sticky_4" value="Ownership can become unclear when the lead owner lacks the expertise for the opportunity and wants to hand it to a specialist ('throwing it over the wall')." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#FFF3A3;strokeColor=#E3C94C;" vertex="1" parent="1"><mxGeometry x="3765.0" y="518.0" width="150.0" height="66.0" as="geometry"/></mxCell><mxCell id="sticky_4_link" style="endArrow=none;dashed=1;dashPattern=2 2;strokeColor=#E3C94C;html=1;" edge="1" parent="1" source="sticky_4" target="n_A15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sticky_5" value="Review of the discussion document is not formalised; whether a four-eyes review happens depends on who is involved and whether price is mentioned." style="shape=note;size=12;whiteSpace=wrap;html=1;fontSize=9;align=left;verticalAlign=top;spacing=6;fillColor=#FFF3A3;strokeColor=#E3C94C;" vertex="1" parent="1"><mxGeometry x="4597.0" y="1350.0" width="150.0" height="66.0" as="geometry"/></mxCell><mxCell id="sticky_5_link" style="endArrow=none;dashed=1;dashPattern=2 2;strokeColor=#E3C94C;html=1;" edge="1" parent="1" source="sticky_5" target="n_A18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.4;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_S0" target="n_A1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.4;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_A1" target="n_D1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.4;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_D1" target="n_A2"><mxGeometry relat